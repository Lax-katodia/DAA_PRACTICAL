#include <iostream>
#include <algorithm>
using namespace std;

struct Edge
{
    int u, v, weight;
};

int parent[100];

// Find parent of a vertex
int find(int x)
{
    if (parent[x] == x)
        return x;

    return parent[x] = find(parent[x]);
}

// Join two sets
void unite(int a, int b)
{
    a = find(a);
    b = find(b);

    if (a != b)
        parent[b] = a;
}

int main()
{
    int V = 5;
    int E = 7;

    Edge edges[E] =
    {
        {0, 1, 2},
        {0, 3, 6},
        {1, 2, 3},
        {1, 3, 8},
        {1, 4, 5},
        {2, 4, 7},
        {3, 4, 9}
    };

    // Sort edges by weight
    sort(edges, edges + E, [](Edge a, Edge b)
    {
        return a.weight < b.weight;
    });

    // Initialize parent
    for (int i = 0; i < V; i++)
        parent[i] = i;

    int totalCost = 0;

    cout << "Edges in MST:\n";

    int count = 0;

    for (int i = 0; i < E && count < V - 1; i++)
    {
        int u = edges[i].u;
        int v = edges[i].v;

        // Check for cycle
        if (find(u) != find(v))
        {
            cout << u << " - " << v
                 << " : " << edges[i].weight << endl;

            totalCost += edges[i].weight;

            unite(u, v);
            count++;
        }
    }

    cout << "Minimum Cost = " << totalCost << endl;

    return 0;
}
